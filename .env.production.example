# 复制为 .env.production，填写实际值；此文件不含真实凭据。
READOR_IMAGE=ghcr.io/yueyefengs/reador:v0.1.0
# 使用 openssl rand -hex 24 生成数据库密码，保持十六进制以免影响连接 URL。
POSTGRES_PASSWORD=replace-with-generated-hex-password
# 使用 openssl rand -hex 32 生成；后续升级始终保留同一密钥。
ENCRYPTION_KEY=replace-with-64-hex-characters
APP_ORIGIN=https://reador.example.com
APP_PORT=3112
COOKIE_SECURE=true

# 服务器模型访问策略：disabled / shared / owner；个人默认 Agent 优先。
ENV_MODEL_ACCESS=disabled
ENV_MODEL_OWNER_EMAIL=
DEFAULT_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=
AI_DNS_MODE=system

STORAGE_BACKEND=local
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOWNLOAD_MODE=s3
QINIU_DOMAIN=
QINIU_S3_REGION=
QINIU_S3_BUCKET=
