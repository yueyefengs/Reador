# 优先运行 npm run setup:env，自动生成完整 .env.local；以下仅说明变量。
# 手工配置时请替换所有占位值；setup:env 会保留已有文件。
DATABASE_URL=postgres://reador:replace-with-generated-password@localhost:5433/reador
POSTGRES_PASSWORD=replace-with-generated-password
ENCRYPTION_KEY=replace-with-64-hex-characters
APP_ORIGIN=http://localhost:3112
COOKIE_SECURE=false
UPLOAD_DIR=./storage
# 真实密钥在系统设置中按账号保存；以下仅供可选的命令行模型验收。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GLM_API_KEY=
GLM_MODEL=
APP_PORT=3112
LOCAL_UID=1000
LOCAL_GID=1000
# 服务器模型使用策略：disabled / shared / owner；个人默认 Agent 优先。
ENV_MODEL_ACCESS=disabled
ENV_MODEL_OWNER_EMAIL=
DEFAULT_MODEL_PROVIDER=deepseek
# 默认本地保存；验证七牛访问权限后改为 qiniu。
STORAGE_BACKEND=local
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# 默认 system；代理 Fake-IP 影响容器时可显式用 doh，仍拒绝私网模型地址。
AI_DNS_MODE=system

# 默认 s3 通过官方签名 API 读取，不要求自定义域名；domain 模式要求有效 HTTPS 域名。
QINIU_DOWNLOAD_MODE=s3
# 留空自动查询区域；S3 空间名不同时可单独指定。
QINIU_S3_REGION=
QINIU_S3_BUCKET=
