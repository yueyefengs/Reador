{
  "name": "reador",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3112",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3112",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx tests/integration.ts",
    "eval:live": "node --env-file-if-exists=.env.local --import tsx scripts/eval-live.ts",
    "setup:env": "tsx scripts/setup-env.ts",
    "eval:storage": "node --env-file-if-exists=.env.local --import tsx scripts/eval-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@napi-rs/canvas": "1.0.10",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "5.11.2",
    "next": "16.4.0",
    "pdfjs-dist": "6.4.299",
    "postgres": "3.4.8",
    "qiniu": "7.15.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "ts-fsrs": "5.4.2",
    "undici": "7.30.0",
    "yauzl": "3.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^2",
    "drizzle-kit": "0.31.8",
    "fflate": "0.8.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "type": "module"
}
